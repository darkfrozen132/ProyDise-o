# 🔧 CONFIGURACIÓN DEL SIMULADOR LOGÍSTICO

# URL del backend (Spring Boot)
# Por defecto: http://localhost:8000
# En producción, cambiar a tu dominio
REACT_APP_BACKEND_URL=http://localhost:8000

